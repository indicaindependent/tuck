name = "tuck"
main = "src/peoples-market-worker.js"
compatibility_date = "2024-12-01"
compatibility_flags = ["nodejs_compat"]

# Workers AI binding (required for Ask Tuck)
[ai]
binding = "AI"

# KV namespace for rate limiting (required)
# Create with: wrangler kv:namespace create "TUCK_KV"
# Then paste the id below
[[kv_namespaces]]
binding = "TUCK_KV"
id = "YOUR_KV_NAMESPACE_ID_HERE"

# Custom domain (optional)
# routes = [
#   { pattern = "market.example.com", custom_domain = true }
# ]

# Secrets (set via: wrangler secret put CAPWATCH_SECRET)
# Do not put secret values in this file
